{
    "ignorePatterns": [
        { "pattern": "^http://localhost" },
        { "pattern": "^https?://127\\." },
        { "pattern": "^https?://example\\.com" },
        { "pattern": "^https?://([a-z0-9-]+)\\.cognitiveservices\\.azure\\.com" },
        { "pattern": "^https?://([a-z0-9-]+)\\.azurewebsites\\.net" },
        { "pattern": "^https?://([a-z0-9-]+)\\.azure-api\\.net" },
        { "pattern": "^https?://management\\.azure\\.com" },
        { "pattern": "^https?://httpstat\\.us" }
    ],
    "replacementPatterns": [
        {
            "pattern": "^/",
            "replacement": "{{BASEURL}}/"
        }
    ],
    "httpHeaders": [
        {
            "urls": ["https://learn.microsoft.com", "https://github.com"],
            "headers": {
                "Accept": "text/html",
                "User-Agent": "Mozilla/5.0 (markdown-link-check)"
            }
        }
    ],
    "timeout": "20s",
    "retryOn429": true,
    "retryCount": 5,
    "fallbackRetryDelay": "30s",
    "aliveStatusCodes": [200, 206, 301, 302, 308, 403, 999]
}
