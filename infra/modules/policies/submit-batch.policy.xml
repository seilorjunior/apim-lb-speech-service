<!--
  Submit-batch operation policy.
  - Routes to round-robin pool with MI auth + retry
  - Request gating (cheap rejections before any backend round-trip):
      * Content-Type allowlist -> 415 if not application/json (charset OK)
      * Body-size cap          -> 413 if Content-Length > 16384 bytes
  - Idempotency-Key handling (optional client-supplied header, Stripe /
    IETF "Idempotency-Key" draft semantics):
      * Inbound  validation:
          - Reject when length > 128 or value does not match
            ^[A-Za-z0-9._-]+$ (HTTP 400). Prevents oversized or
            delimiter-laden values from polluting the cache namespace.
      * Inbound  body-fingerprint + in-flight checks:
          - Compute SHA-256 of the request body.
          - Look up speech-idem-hash-<key>:
              * Match    -> replay cached 201 (body + Location), with
                            X-Idempotent-Replay: true.
              * Mismatch -> 422 IdempotencyKeyConflict.
              * Absent   -> look up speech-idem-lock-<key>; if present
                            (concurrent request still running) return
                            409 IdempotencyInFlight (best-effort,
                            APIM cache has no atomic CAS so the race
                            window between lookup+store is tiny but
                            non-zero).
              * Else     -> write the lock sentinel (5-min TTL, expires
                            naturally if the upstream call fails) and
                            forward to Speech.
      * Outbound on 201 Created:
          - Cache the response body     -> speech-idem-<key>
          - Cache the response Location -> speech-idem-loc-<key>
          - Cache the body fingerprint  -> speech-idem-hash-<key>
          - All three keyed by APIM named value {{idempotency-ttl-seconds}}
            so the TTL can be tuned without redeploying this XML.
  - On 201, parses the Speech "Location" header to:
      * identify which backend handled the request (by host)
      * extract the jobId (last path segment)
      * cache jobId -> backend-id (24h TTL)
  - The cache is the APIM external cache when configured (Azure Managed
    Redis in this template); falls back to the APIM internal cache
    otherwise. This is what `caching-type="prefer-external"` does.
  - The Function App is responsible for translating the jobId to subsequent
    APIM URLs; we do NOT rewrite response URLs here.

  Tokens replaced at deploy time by Bicep:
    __PRIMARY_HOST__       Speech primary account hostname
    __SECONDARY_HOST__     Speech secondary account hostname
    __PRIMARY_BACKEND__    APIM backend id for the primary
    __SECONDARY_BACKEND__  APIM backend id for the secondary

  APIM named values referenced (configured in apim.bicep):
    {{idempotency-ttl-seconds}}  TTL for cached idempotency entries.
-->
<policies>
  <inbound>
    <base />
    <set-backend-service backend-id="speech-pool" />
    <authentication-managed-identity resource="https://cognitiveservices.azure.com" />
    <!--
      Cheap request-shape gates: reject malformed clients before any
      Speech round-trip. These run before idempotency so an obviously
      bad request never pollutes the cache namespace.
    -->
    <choose>
      <when condition='@{
        var ct = context.Request.Headers.GetValueOrDefault("Content-Type", "");
        if (string.IsNullOrEmpty(ct)) { return true; }
        var i = ct.IndexOf(&apos;;&apos;);
        var media = (i &gt;= 0 ? ct.Substring(0, i) : ct).Trim().ToLowerInvariant();
        return media != "application/json";
      }'>
        <return-response>
          <set-status code="415" reason="Unsupported Media Type" />
          <set-header name="Content-Type" exists-action="override">
            <value>application/json</value>
          </set-header>
          <set-body>{"error":{"code":"UnsupportedMediaType","message":"Content-Type must be application/json."}}</set-body>
        </return-response>
      </when>
    </choose>
    <choose>
      <when condition='@{
        var clHeader = context.Request.Headers.GetValueOrDefault("Content-Length", "");
        int cl;
        if (int.TryParse(clHeader, out cl) &amp;&amp; cl &gt; 16384) { return true; }
        return false;
      }'>
        <return-response>
          <set-status code="413" reason="Payload Too Large" />
          <set-header name="Content-Type" exists-action="override">
            <value>application/json</value>
          </set-header>
          <set-body>{"error":{"code":"PayloadTooLarge","message":"Request body exceeds 16 KiB. Batch transcription accepts URL references, not inline audio."}}</set-body>
        </return-response>
      </when>
    </choose>
    <!--
      Idempotency-Key validation. Result conventions:
        ""        -> header absent, idempotency feature disabled.
        "INVALID" -> header present but rejected (length / charset).
        otherwise -> the raw, validated key.
    -->
    <set-variable name="rawIdemKey" value='@{
      var k = context.Request.Headers.GetValueOrDefault("Idempotency-Key", "");
      if (string.IsNullOrEmpty(k)) { return ""; }
      if (k.Length &gt; 128) { return "INVALID"; }
      if (!System.Text.RegularExpressions.Regex.IsMatch(k, "^[A-Za-z0-9._-]+$")) { return "INVALID"; }
      return k;
    }' />
    <choose>
      <when condition='@((string)context.Variables["rawIdemKey"] == "INVALID")'>
        <return-response>
          <set-status code="400" reason="Bad Request" />
          <set-header name="Content-Type" exists-action="override">
            <value>application/json</value>
          </set-header>
          <set-body>{"error":{"code":"InvalidIdempotencyKey","message":"Idempotency-Key must be 1-128 characters and match ^[A-Za-z0-9._-]+$."}}</set-body>
        </return-response>
      </when>
    </choose>
    <choose>
      <when condition='@(!string.IsNullOrEmpty((string)context.Variables["rawIdemKey"]))'>
        <!--
          SHA-256 fingerprint of the request body. Used to detect
          "same key, different body" misuse. preserveContent=true keeps
          the body available for the upstream forward-request below.
        -->
        <set-variable name="bodyHash" value='@{
          var bytes = context.Request.Body.As&lt;byte[]&gt;(preserveContent: true);
          var sha = System.Security.Cryptography.SHA256.Create();
          var hash = sha.ComputeHash(bytes);
          return BitConverter.ToString(hash).Replace("-", "").ToLowerInvariant();
        }' />
        <set-variable name="idemKey"     value='@("speech-idem-"      + (string)context.Variables["rawIdemKey"])' />
        <set-variable name="idemHashKey" value='@("speech-idem-hash-" + (string)context.Variables["rawIdemKey"])' />
        <set-variable name="idemLocKey"  value='@("speech-idem-loc-"  + (string)context.Variables["rawIdemKey"])' />
        <set-variable name="idemLockKey" value='@("speech-idem-lock-" + (string)context.Variables["rawIdemKey"])' />
        <!--
          Look up the stored fingerprint first. If absent, this is the
          first request for this key (or the entry has expired) -> fall
          through and submit normally; outbound will populate the cache.
        -->
        <cache-lookup-value caching-type="prefer-external"
                            key='@((string)context.Variables["idemHashKey"])'
                            variable-name="cachedHash" />
        <choose>
          <when condition='@(context.Variables.ContainsKey("cachedHash") &amp;&amp; (string)context.Variables["cachedHash"] != (string)context.Variables["bodyHash"])'>
            <!-- Same key, different body -> 422 per IETF draft. -->
            <return-response>
              <set-status code="422" reason="Unprocessable Entity" />
              <set-header name="Content-Type" exists-action="override">
                <value>application/json</value>
              </set-header>
              <set-body>{"error":{"code":"IdempotencyKeyConflict","message":"This Idempotency-Key was previously used with a different request body."}}</set-body>
            </return-response>
          </when>
          <when condition='@(context.Variables.ContainsKey("cachedHash"))'>
            <!--
              Hash matches -> body must be in the cache too (same TTL,
              written together). Look it up and replay the original 201,
              including the cached Location header so polling URLs work.
            -->
            <cache-lookup-value caching-type="prefer-external"
                                key='@((string)context.Variables["idemKey"])'
                                variable-name="idemReplay" />
            <cache-lookup-value caching-type="prefer-external"
                                key='@((string)context.Variables["idemLocKey"])'
                                variable-name="idemReplayLoc" />
            <choose>
              <when condition='@(context.Variables.ContainsKey("idemReplay"))'>
                <return-response>
                  <set-status code="201" reason="Created (idempotent replay)" />
                  <set-header name="Content-Type" exists-action="override">
                    <value>application/json</value>
                  </set-header>
                  <set-header name="Location" exists-action="override">
                    <value>@(context.Variables.ContainsKey("idemReplayLoc") ? (string)context.Variables["idemReplayLoc"] : "")</value>
                  </set-header>
                  <set-header name="X-Idempotent-Replay" exists-action="override">
                    <value>true</value>
                  </set-header>
                  <set-body>@((string)context.Variables["idemReplay"])</set-body>
                </return-response>
              </when>
            </choose>
          </when>
          <otherwise>
            <!--
              Hash absent -> first time we see this key, or TTL expired.
              Best-effort concurrent in-flight guard: if a sentinel from
              a still-running sibling request is present, refuse with
              409 IdempotencyInFlight. Otherwise stamp the sentinel
              (5-min TTL) so a concurrent duplicate can detect us.
              Note: APIM cache has no atomic compare-and-set, so the
              window between lookup and store is racy; the guard
              short-circuits the common case (sequential retries while
              the original is still running) but cannot prevent two
              true-simultaneous arrivals from both forwarding.
            -->
            <cache-lookup-value caching-type="prefer-external"
                                key='@((string)context.Variables["idemLockKey"])'
                                variable-name="idemLock" />
            <choose>
              <when condition='@(context.Variables.ContainsKey("idemLock"))'>
                <return-response>
                  <set-status code="409" reason="Conflict" />
                  <set-header name="Content-Type" exists-action="override">
                    <value>application/json</value>
                  </set-header>
                  <set-header name="Retry-After" exists-action="override">
                    <value>5</value>
                  </set-header>
                  <set-body>{"error":{"code":"IdempotencyInFlight","message":"A request with this Idempotency-Key is already in progress. Retry after a few seconds."}}</set-body>
                </return-response>
              </when>
              <otherwise>
                <cache-store-value
                  caching-type="prefer-external"
                  key='@((string)context.Variables["idemLockKey"])'
                  value="InProgress"
                  duration="300" />
              </otherwise>
            </choose>
          </otherwise>
        </choose>
      </when>
    </choose>
  </inbound>
  <backend>
    <retry condition="@(context.Response.StatusCode == 429 || context.Response.StatusCode >= 500)"
           count="3" interval="1" delta="1" max-interval="10" first-fast-retry="false">
      <forward-request buffer-request-body="true" />
    </retry>
  </backend>
  <outbound>
    <base />
    <choose>
      <when condition="@(context.Response.StatusCode == 201)">
        <!-- Parse the Location header once and stash the derived
             cache key + backend-id into context variables. Any
             failure (missing header, malformed URI, unknown host)
             leaves the variables empty so the cache-store-value
             below is skipped. -->
        <set-variable name="speechCacheKey" value='@{
          try {
            var loc = context.Response.Headers.GetValueOrDefault("Location", "");
            if (string.IsNullOrEmpty(loc)) { return ""; }
            var p = new System.Uri(loc).AbsolutePath;
            var i = p.LastIndexOf(&apos;/&apos;);
            if (i &lt; 0 || i &gt;= p.Length - 1) { return ""; }
            return "speech-job-" + p.Substring(i + 1);
          } catch { return ""; }
        }' />
        <set-variable name="speechBackendId" value='@{
          try {
            var loc = context.Response.Headers.GetValueOrDefault("Location", "");
            if (string.IsNullOrEmpty(loc)) { return ""; }
            var h = new System.Uri(loc).Host;
            if (string.Equals(h, "__PRIMARY_HOST__",   StringComparison.OrdinalIgnoreCase)) { return "__PRIMARY_BACKEND__"; }
            if (string.Equals(h, "__SECONDARY_HOST__", StringComparison.OrdinalIgnoreCase)) { return "__SECONDARY_BACKEND__"; }
            return "";
          } catch { return ""; }
        }' />
        <choose>
          <when condition='@(((string)context.Variables["speechCacheKey"]).StartsWith("speech-job-") &amp;&amp; !string.IsNullOrEmpty((string)context.Variables["speechBackendId"]))'>
            <cache-store-value
              caching-type="prefer-external"
              key='@((string)context.Variables["speechCacheKey"])'
              value='@((string)context.Variables["speechBackendId"])'
              duration="86400" />
          </when>
          <otherwise>
            <trace source="speech-stt" severity="error">
              <message>@("submit-batch: skipped cache-store (key=" + (string)context.Variables["speechCacheKey"] + ", backend=" + (string)context.Variables["speechBackendId"] + ", location=" + context.Response.Headers.GetValueOrDefault("Location", "") + ")")</message>
            </trace>
          </otherwise>
        </choose>
        <!--
          Idempotency persistence. When the client supplied a valid
          Idempotency-Key, cache the response body, the Location
          header, and the request fingerprint under the same TTL
          ({{idempotency-ttl-seconds}} named value). On a retry with
          the same key + same body the inbound branch above replays
          this 201 verbatim (including Location); on a retry with the
          same key + different body it returns 422.
          `preserveContent: true` snapshots the body without consuming
          it for the current response.
        -->
        <choose>
          <when condition='@(!string.IsNullOrEmpty((string)context.Variables["rawIdemKey"]))'>
            <cache-store-value
              caching-type="prefer-external"
              key='@((string)context.Variables["idemKey"])'
              value='@(context.Response.Body.As&lt;string&gt;(preserveContent: true))'
              duration="{{idempotency-ttl-seconds}}" />
            <cache-store-value
              caching-type="prefer-external"
              key='@((string)context.Variables["idemLocKey"])'
              value='@(context.Response.Headers.GetValueOrDefault("Location", ""))'
              duration="{{idempotency-ttl-seconds}}" />
            <cache-store-value
              caching-type="prefer-external"
              key='@((string)context.Variables["idemHashKey"])'
              value='@((string)context.Variables["bodyHash"])'
              duration="{{idempotency-ttl-seconds}}" />
          </when>
        </choose>
      </when>
    </choose>
  </outbound>
  <on-error>
    <base />
  </on-error>
</policies>

