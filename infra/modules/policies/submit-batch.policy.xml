<!--
  Submit-batch operation policy.
  - Routes to round-robin pool with MI auth + retry
  - Idempotency-Key handling (optional client-supplied header):
      * Inbound  — if header present, look up cached response body and
                   short-circuit with 201 + cached body on hit.
      * Outbound — on 201 Created, cache the response body for 1 h
                   keyed by `speech-idem-<key>`. A retried POST with the
                   same Idempotency-Key returns the original 201 instead
                   of submitting a duplicate batch job.
  - On 201, parses the Speech "Location" header to:
      * identify which backend handled the request (by host)
      * extract the jobId (last path segment)
      * cache jobId -> backend-id (24h TTL)
  - The cache is the APIM external cache when configured (Azure Managed
    Redis in this template); falls back to the APIM internal cache
    otherwise. This is what `caching-type="prefer-external"` does.
  - The Function App is responsible for translating the jobId to subsequent
    APIM URLs; we do NOT rewrite response URLs here.

  Tokens replaced at deploy time by Bicep:
    __PRIMARY_HOST__       Speech primary account hostname
    __SECONDARY_HOST__     Speech secondary account hostname
    __PRIMARY_BACKEND__    APIM backend id for the primary
    __SECONDARY_BACKEND__  APIM backend id for the secondary
-->
<policies>
  <inbound>
    <base />
    <set-backend-service backend-id="speech-pool" />
    <authentication-managed-identity resource="https://cognitiveservices.azure.com" />
    <!-- Idempotency: derive the cache key once (empty string if header absent). -->
    <set-variable name="idemKey" value="@{
      var k = context.Request.Headers.GetValueOrDefault(&quot;Idempotency-Key&quot;, &quot;&quot;);
      return string.IsNullOrEmpty(k) ? &quot;&quot; : &quot;speech-idem-&quot; + k;
    }" />
    <choose>
      <when condition="@(!string.IsNullOrEmpty((string)context.Variables[&quot;idemKey&quot;]))">
        <cache-lookup-value caching-type="prefer-external"
                            key="@((string)context.Variables[&quot;idemKey&quot;])"
                            variable-name="idemReplay" />
        <choose>
          <when condition="@(context.Variables.ContainsKey(&quot;idemReplay&quot;))">
            <!-- Cached hit: return the original 201 body without forwarding to Speech. -->
            <return-response>
              <set-status code="201" reason="Created (idempotent replay)" />
              <set-header name="Content-Type" exists-action="override">
                <value>application/json</value>
              </set-header>
              <set-header name="X-Idempotent-Replay" exists-action="override">
                <value>true</value>
              </set-header>
              <set-body>@((string)context.Variables["idemReplay"])</set-body>
            </return-response>
          </when>
        </choose>
      </when>
    </choose>
  </inbound>
  <backend>
    <retry condition="@(context.Response.StatusCode == 429 || context.Response.StatusCode >= 500)"
           count="3" interval="1" delta="1" max-interval="10" first-fast-retry="false">
      <forward-request buffer-request-body="true" />
    </retry>
  </backend>
  <outbound>
    <base />
    <choose>
      <when condition="@(context.Response.StatusCode == 201)">
        <!-- Parse the Location header once and stash the derived
             cache key + backend-id into context variables. Any
             failure (missing header, malformed URI, unknown host)
             leaves the variables empty so the cache-store-value
             below is skipped. -->
        <set-variable name="speechCacheKey" value="@{
          try {
            var loc = context.Response.Headers.GetValueOrDefault(&quot;Location&quot;, &quot;&quot;);
            if (string.IsNullOrEmpty(loc)) { return &quot;&quot;; }
            var p = new System.Uri(loc).AbsolutePath;
            var i = p.LastIndexOf('/');
            if (i &lt; 0 || i &gt;= p.Length - 1) { return &quot;&quot;; }
            return &quot;speech-job-&quot; + p.Substring(i + 1);
          } catch { return &quot;&quot;; }
        }" />
        <set-variable name="speechBackendId" value="@{
          try {
            var loc = context.Response.Headers.GetValueOrDefault(&quot;Location&quot;, &quot;&quot;);
            if (string.IsNullOrEmpty(loc)) { return &quot;&quot;; }
            var h = new System.Uri(loc).Host;
            if (string.Equals(h, &quot;__PRIMARY_HOST__&quot;,   StringComparison.OrdinalIgnoreCase)) { return &quot;__PRIMARY_BACKEND__&quot;; }
            if (string.Equals(h, &quot;__SECONDARY_HOST__&quot;, StringComparison.OrdinalIgnoreCase)) { return &quot;__SECONDARY_BACKEND__&quot;; }
            return &quot;&quot;;
          } catch { return &quot;&quot;; }
        }" />
        <choose>
          <when condition="@(((string)context.Variables[&quot;speechCacheKey&quot;]).StartsWith(&quot;speech-job-&quot;) &amp;&amp; !string.IsNullOrEmpty((string)context.Variables[&quot;speechBackendId&quot;]))">
            <cache-store-value
              caching-type="prefer-external"
              key="@((string)context.Variables[&quot;speechCacheKey&quot;])"
              value="@((string)context.Variables[&quot;speechBackendId&quot;])"
              duration="86400" />
          </when>
          <otherwise>
            <trace source="speech-stt" severity="error">
              <message>@("submit-batch: skipped cache-store (key=" + (string)context.Variables["speechCacheKey"] + ", backend=" + (string)context.Variables["speechBackendId"] + ", location=" + context.Response.Headers.GetValueOrDefault("Location", "") + ")")</message>
            </trace>
          </otherwise>
        </choose>
        <!-- Idempotency: when the client supplied Idempotency-Key, cache the
             response body for 1 h so a retried POST with the same key
             returns this 201 instead of submitting a duplicate batch job.
             `preserveContent: true` keeps the body available for the
             current response (we only snapshot it). -->
        <choose>
          <when condition="@(!string.IsNullOrEmpty((string)context.Variables[&quot;idemKey&quot;]))">
            <cache-store-value
              caching-type="prefer-external"
              key="@((string)context.Variables[&quot;idemKey&quot;])"
              value="@(context.Response.Body.As&lt;string&gt;(preserveContent: true))"
              duration="3600" />
          </when>
        </choose>
      </when>
    </choose>
  </outbound>
  <on-error>
    <base />
  </on-error>
</policies>
